<?xml version="1.0"?>
<!-- This is the URDF file for Robotiq 2f 140 Gripper-->
<!-- This file is meant to be included, not standalone -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

            <!-- Include UR to Robotiq adapter -->
            <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
            <xacro:arg name="tf_prefix" default=""/>
            <xacro:ur_to_robotiq
                prefix=""
                parent="$(arg tf_prefix)tool0"
                child="neo_gripper_mount_link"
                rotation="${pi/2}"
                />

            <!-- Include Robotiq 2F-140 gripper -->
            <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>
            <xacro:robotiq_gripper
                name="RobotiqGripperHardwareInterface"
                prefix=""
                parent="neo_gripper_mount_link"
                sim_gazebo="true"
                include_ros2_control="true"
                use_fake_hardware="false"
                com_port="/dev/ttyUSB0">
                <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
            </xacro:robotiq_gripper>

            <!-- Gazebo-specific material properties for gripper -->
            <gazebo reference="robotiq_140_base_link">
                <material>Gazebo/DarkGrey</material>
            </gazebo>

            <gazebo reference="left_outer_knuckle">
                <material>Gazebo/Grey</material>
            </gazebo>

            <gazebo reference="left_outer_finger">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="left_inner_knuckle">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="left_inner_finger">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="left_inner_finger_pad">
                <material>Gazebo/FlatBlack</material>
            </gazebo>

            <gazebo reference="right_outer_knuckle">
                <material>Gazebo/Grey</material>
            </gazebo>

            <gazebo reference="right_outer_finger">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="right_inner_knuckle">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="right_inner_finger">
                <material>Gazebo/Black</material>
            </gazebo>

            <gazebo reference="right_inner_finger_pad">
                <material>Gazebo/FlatBlack</material>
            </gazebo>

</robot>
