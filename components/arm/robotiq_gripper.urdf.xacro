<?xml version="1.0"?>
<!-- This is the URDF file for Robotiq 2f 140 Gripper-->
<!-- This file is meant to be included, not standalone -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

            <!-- Include UR to Robotiq adapter -->
            <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
            <xacro:arg name="tf_prefix" default=""/>
            <xacro:ur_to_robotiq
                prefix=""
                parent="$(arg tf_prefix)tool0"
                child="neo_gripper_mount_link"
                rotation="${pi/2}"
                />

            <!-- Include Robotiq 2F-140 gripper -->
            <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_140_macro.urdf.xacro"/>
            <xacro:robotiq_gripper
                name="RobotiqGripperHardwareInterface"
                prefix=""
                parent="neo_gripper_mount_link"
                sim_gazebo="false"
                include_ros2_control="false"
                use_fake_hardware="false"
                com_port="/dev/ttyUSB0">
                <origin xyz="0 0 0" rpy="0 0 -${pi / 2}"/>
            </xacro:robotiq_gripper>

            <!-- Provide a simple Gazebo ros2_control block for the gripper -->
            <ros2_control name="robotiq_gripper" type="system">
                <hardware>
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </hardware>
                <joint name="finger_joint">
                    <command_interface name="position"/>
                    <state_interface name="position"/>
                    <state_interface name="velocity"/>
                </joint>
            </ros2_control>

</robot>
